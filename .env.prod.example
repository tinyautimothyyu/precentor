# Production config for docker-compose.prod.yml. Copy to .env.prod (gitignored).

# Public hostname; DNS A/AAAA record must point at this server (ports 80/443 open).
DOMAIN=precentor.example.org

# Generate with: openssl rand -hex 32  (keep URL-safe; it goes into DATABASE_URL)
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 50
SECRET_KEY=change-me

TIME_ZONE=UTC

# Sheet file storage. false = Docker volume on this host; true = S3-compatible bucket.
USE_S3=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=      # only for non-AWS providers (B2, R2, MinIO, ...)
# AWS_S3_REGION_NAME=

# Optional: enables in-app YouTube search.
# YOUTUBE_API_KEY=
