# Copy to backend/.env for local runs outside Docker. In Docker these are
# supplied by docker-compose.yml instead.

DJANGO_SETTINGS_MODULE=precentor.settings.dev
SECRET_KEY=insecure-dev-key-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=postgres://precentor:precentor@db:5432/precentor
TIME_ZONE=UTC
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- S3-compatible storage (set USE_S3=true to enable) -------------------
USE_S3=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://s3.us-west-000.backblazeb2.com
# AWS_S3_REGION_NAME=us-west-000
